<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="#2A261D" />
            <stroke android:width="2.5dp" android:color="#E5B84B" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#1E1D1A" />
            <stroke android:width="1dp" android:color="#2E2D29" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
